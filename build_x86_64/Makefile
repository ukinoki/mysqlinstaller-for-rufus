MySQLInstaller.app/Contents/PkgInfo: 
	@test -d MySQLInstaller.app/Contents || mkdir -p MySQLInstaller.app/Contents
	@$(DEL_FILE) MySQLInstaller.app/Contents/PkgInfo
	@echo "APPL????" > MySQLInstaller.app/Contents/PkgInfo
MySQLInstaller.app/Contents/Info.plist: 
	@test -d MySQLInstaller.app/Contents || mkdir -p MySQLInstaller.app/Contents
	@$(DEL_FILE) MySQLInstaller.app/Contents/Info.plist
	@set -o pipefail && plutil -convert xml1 -o - ../resources/Info.plist | sed -e "s,@SHORT_VERSION@,1.0,g" -e "s,\$${QMAKE_SHORT_VERSION},1.0,g" -e "s,@FULL_VERSION@,1.0.0,g" -e "s,\$${QMAKE_FULL_VERSION},1.0.0,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" -e "s,@BUNDLEIDENTIFIER@,s.MySQLInstaller,g" -e "s,\$${PRODUCT_BUNDLE_IDENTIFIER},s.MySQLInstaller,g" -e "s,\$${MACOSX_DEPLOYMENT_TARGET},13.0,g" -e "s,\$${IPHONEOS_DEPLOYMENT_TARGET},,g" -e "s,\$${TVOS_DEPLOYMENT_TARGET},,g" -e "s,\$${WATCHOS_DEPLOYMENT_TARGET},,g" -e "s,\$${IOS_LAUNCH_SCREEN},LaunchScreen,g" -e "s,@ICON@,app.icns,g" -e "s,\$${ASSETCATALOG_COMPILER_APPICON_NAME},app.icns,g" -e "s,@EXECUTABLE@,MySQLInstaller,g" -e "s,@LIBRARY@,MySQLInstaller,g" -e "s,\$${EXECUTABLE_NAME},MySQLInstaller,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" >MySQLInstaller.app/Contents/Info.plist
MySQLInstaller.app/Contents/Resources/app.icns: ../resources/app.icns
	@test -d MySQLInstaller.app/Contents/Resources/ || mkdir -p MySQLInstaller.app/Contents/Resources/
	@$(DEL_FILE) MySQLInstaller.app/Contents/Resources/app.icns
	@$(COPY_FILE) ../resources/app.icns MySQLInstaller.app/Contents/Resources/app.icns

